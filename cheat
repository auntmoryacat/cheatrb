local energyToggle = false
local collectToggle = false
local godMode = false
local farmRunning = false
local farmConnection = nil

local function teleportToEgg()
    local eggs = workspace:FindFirstChild("Eggs") or workspace:FindFirstChild("Egg")
    if not eggs then return end
    local nearest, dist = nil, math.huge
    for _, egg in pairs(eggs:GetChildren()) do
        if egg:IsA("BasePart") and string.lower(egg.Name):find("egg") then
            local d = (egg.Position - rootPart.Position).Magnitude
            if d < dist then dist = d; nearest = egg end
        end
    end
    if nearest then
        rootPart.CFrame = CFrame.new(nearest.Position + Vector3.new(0, 3, 0))
    end
end

local function toggleEnergy()
    energyToggle = not energyToggle
    if energyToggle then
        game:GetService("RunService").Heartbeat:Connect(function()
            if energyToggle then
                local stats = player:FindFirstChild("leaderstats")
                if stats and stats:FindFirstChild("Energy") then
                    stats.Energy.Value = 9999
                end
            end
        end)
    end
end

local function toggleAutoCollect()
    collectToggle = not collectToggle
    if collectToggle then
        spawn(function()
            while collectToggle do
                local eggs = workspace:FindFirstChild("Eggs") or workspace:FindFirstChild("Egg")
                if eggs then
                    for _, egg in pairs(eggs:GetChildren()) do
                        if egg:IsA("BasePart") and string.lower(egg.Name):find("egg") then
                            local cd = egg:FindFirstChild("ClickDetector")
                            if cd then fireclickdetector(cd) end
                        end
                    end
                end
                task.wait(0.1)
            end
        end)
    end
end

local function toggleGodMode()
    godMode = not godMode
    if godMode then
        humanoid.MaxHealth = math.huge
        humanoid.Health = math.huge
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    else
        humanoid.MaxHealth = 100
        humanoid.Health = 100
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
    end
end

local function toggleFarm()
    if farmRunning then
        farmRunning = false
        if farmConnection then
            game:GetService("RunService"):UnbindFromRenderStep("FarmLoop")
            farmConnection = nil
        end
        return
    end
    farmRunning = true
    farmConnection = game:GetService("RunService").RenderStepped:Connect(function()
        if not farmRunning then return end
        local eggs = workspace:FindFirstChild("Eggs") or workspace:FindFirstChild("Egg")
        if eggs then
            for _, egg in pairs(eggs:GetChildren()) do
                if egg:IsA("BasePart") and string.lower(egg.Name):find("egg") then
                    rootPart.CFrame = CFrame.new(egg.Position + Vector3.new(0, 3, 0))
                    task.wait(0.15)
                    local cd = egg:FindFirstChild("ClickDetector")
                    if cd then fireclickdetector(cd) end
                    task.wait(0.2)
                end
            end
        end
        task.wait(0.3)
    end)
end

