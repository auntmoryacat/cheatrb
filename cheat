-- ESP (отображение яиц и игроков)
local function toggleESP()
    local espOn = false
    local espObjects = {}
    local function createESP()
        -- Простое выделение яиц (можно расширить)
        local eggs = findAllEggs()
        for _, egg in ipairs(eggs) do
            if not egg:FindFirstChild("ESP_Highlight") then
                local highlight = Instance.new("Highlight")
                highlight.Name = "ESP_Highlight"
                highlight.FillColor = Color3.fromRGB(0, 255, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.Adornee = egg
                highlight.Parent = egg
                table.insert(espObjects, highlight)
            end
        end
    end
    local function clearESP()
        for _, obj in ipairs(espObjects) do
            obj:Destroy()
        end
        espObjects = {}
        -- Также удалим все хайлайты с именем ESP_Highlight
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name == "ESP_Highlight" then
                obj:Destroy()
            end
        end
    end

    if espOn then
        clearESP()
        espOn = false
    else
        createESP()
        espOn = true
    end
    print("[DEBUG] ESP:", espOn and "ON" or "OFF")
end

