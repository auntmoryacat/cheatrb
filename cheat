local function showError(text)
    msg.Text = text
    msg.TextColor3 = Color3.fromRGB(255, 80, 80)
    task.wait(0.6)
    msg.Text = ""
end

local function shakeFrame()
    for i = 1, 6 do
        frame.Position = UDim2.new(0.5, -170 + (i % 2 == 0 and 12 or -12), 0.5, -130)
        task.wait(0.04)
    end
    frame.Position = UDim2.new(0.5, -170, 0.5, -130)
end

local function onLogin()
    local user = userBox.Text:gsub("^%s*(.-)%s*$", "%1")
    local pass = passBox.Text:gsub("^%s*(.-)%s*$", "%1")
    
    if user == "" or pass == "" then
        showError("❌ Заполните все поля")
        return
    end
    
    if user == "egor" and pass == "lox" then
        -- Успешный вход
        msg.Text = "✅ Доступ разрешён!"
        msg.TextColor3 = Color3.fromRGB(80, 255, 80)
        task.wait(0.4)
        
        -- Скрываем окно входа
        screenGui.Enabled = false
        blur.Size = 0
        
        -- ===== ЗАГРУЗКА ОСНОВНОГО ЧИТА =====
        -- Speed Hub X — стабильный чит с авто-стилом, хэтчем, апгрейдом и другими функциями[reference:3]
        local success, err = pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/AhmadV99/Speed-Hub-X/main/Speed%20Hub%20X.lua", true))()
        end)
        
        if not success then
            -- Резервный вариант: Solix Hub[reference:4]
            pcall(function()
                loadstring(game:HttpGet("https://solixhub.com/loader"))()
            end)
        end
        
        print("✅ Чит активирован. Логин: egor")
    else
        showError("❌ Неверный логин или пароль")
        shakeFrame()
        userBox.Text = ""
        passBox.Text = ""
        userBox:CaptureFocus()
    end
end

loginBtn.MouseButton1Click:Connect(onLogin)

-- Вход по Enter
game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
        if screenGui.Enabled then
            local focused = game:GetService("GuiService"):GetFocusedObject()
            if focused and (focused == userBox or focused == passBox or focused == loginBtn) then
                onLogin()
            end
        end
    end
end)

