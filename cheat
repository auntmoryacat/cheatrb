local function findAllEggs()
    local eggs = {}
    -- Поиск по всем объектам в workspace, которые содержат "egg" в имени (без учёта регистра)
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and string.lower(obj.Name):find("egg") then
            table.insert(eggs, obj)
        end
    end
    -- Если ничего не найдено, попробуем искать по папкам "Eggs", "Egg", "EggsFolder" и т.д.
    if #eggs == 0 then
        for _, folder in pairs(workspace:GetChildren()) do
            if folder:IsA("Folder") and string.lower(folder.Name):find("egg") then
                for _, child in pairs(folder:GetChildren()) do
                    if child:IsA("BasePart") then
                        table.insert(eggs, child)
                    end
                end
            end
        end
    end
    return eggs
end

local function findClickDetector(part)
    local cd = part:FindFirstChild("ClickDetector")
    if not cd then
        -- ищем ClickDetector среди потомков
        for _, child in pairs(part:GetDescendants()) do
            if child:IsA("ClickDetector") then
                cd = child
                break
            end
        end
    end
    return cd
end

-- ===== АВТОПОИСК СТАТИСТИКИ ЭНЕРГИИ =====
local function findEnergyStat()
    local stats = player:FindFirstChild("leaderstats")
    if stats then
        for _, stat in pairs(stats:GetChildren()) do
            if stat:IsA("NumberValue") and string.lower(stat.Name):find("energy") then
                return stat
            end
        end
    end
    -- альтернативный поиск в player
    for _, child in pairs(player:GetChildren()) do
        if child:IsA("NumberValue") and string.lower(child.Name):find("energy") then
            return child
        end
    end
    return nil
end

