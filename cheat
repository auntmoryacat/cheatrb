-- ФУНКЦИИ С АВТОПОИСКОМ
local function teleportToEgg()
    local eggs = findAllEggs()
    if #eggs == 0 then
        loginMsg.Text = "❌ Яйца не найдены!"
        loginMsg.TextColor3 = Color3.fromRGB(255, 80, 80)
        wait(1)
        loginMsg.Text = ""
        return
    end
    local nearest, dist = nil, math.huge
    for _, egg in pairs(eggs) do
        if egg:IsA("BasePart") then
            local d = (egg.Position - rootPart.Position).Magnitude
            if d < dist then dist = d; nearest = egg end
        end
    end
    if nearest then
        rootPart.CFrame = CFrame.new(nearest.Position + Vector3.new(0, 3, 0))
        print("[DEBUG] Телепорт к:", nearest.Name)
    end
end

local function toggleEnergy()
    energyToggle = not energyToggle
    if energyToggle then
        game:GetService("RunService").Heartbeat:Connect(function()
            if energyToggle and energyStat then
                energyStat.Value = 9999
            end
        end)
        print("[DEBUG] Бесконечная энергия ВКЛ")
    else
        print("[DEBUG] Бесконечная энергия ВЫКЛ")
    end
end

local function toggleAutoCollect()
    collectToggle = not collectToggle
    if collectToggle then
        spawn(function()
            while collectToggle do
                local eggs = findAllEggs()
                for _, egg in pairs(eggs) do
                    local cd = findClickDetector(egg)
                    if cd then
                        fireclickdetector(cd)
                    end
                end
                task.wait(0.1)
            end
        end)
        print("[DEBUG] Автосбор ВКЛ")
    else
        print("[DEBUG] Автосбор ВЫКЛ")
    end
end

local function toggleGodMode()
    godMode = not godMode
    if godMode then
        humanoid.MaxHealth = 9e9
        humanoid.Health = 9e9
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        print("[DEBUG] GodMode ВКЛ")
    else
        humanoid.MaxHealth = 100
        humanoid.Health = 100
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
        print("[DEBUG] GodMode ВЫКЛ")
    end
end

local function toggleFarm()
    if farmRunning then
        farmRunning = false
        if farmConnection then
            game:GetService("RunService"):UnbindFromRenderStep("FarmLoop")
            farmConnection = nil
        end
        print("[DEBUG] Автофарм ВЫКЛ")
        return
    end
    farmRunning = true
    farmConnection = game:GetService("RunService").RenderStepped:Connect(function()
        if not farmRunning then return end
        local eggs = findAllEggs()
        for _, egg in pairs(eggs) do
            if egg:IsA("BasePart") then
                rootPart.CFrame = CFrame.new(egg.Position + Vector3.new(0, 3, 0))
                task.wait(0.15)
                local cd = findClickDetector(egg)
                if cd then fireclickdetector(cd) end
                task.wait(0.2)
            end
        end
        task.wait(0.3)
    end)
    print("[DEBUG] Автофарм ВКЛ")
end

