local function findAllEggs()
    local eggs = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (string.lower(obj.Name):find("egg") or string.lower(obj.Name):find("яйц")) then
            table.insert(eggs, obj)
        end
    end
    if #eggs == 0 then
        for _, folder in ipairs(Workspace:GetChildren()) do
            if folder:IsA("Folder") and (string.lower(folder.Name):find("egg") or string.lower(folder.Name):find("яйц")) then
                for _, child in ipairs(folder:GetChildren()) do
                    if child:IsA("BasePart") then
                        table.insert(eggs, child)
                    end
                end
            end
        end
    end
    return eggs
end

local function findClickDetector(part)
    local cd = part:FindFirstChild("ClickDetector")
    if not cd then
        for _, child in ipairs(part:GetDescendants()) do
            if child:IsA("ClickDetector") then
                cd = child
                break
            end
        end
    end
    return cd
end

local function findEnergyStat()
    local stats = player:FindFirstChild("leaderstats")
    if stats then
        for _, stat in ipairs(stats:GetChildren()) do
            if stat:IsA("NumberValue") and (string.lower(stat.Name):find("energy") or string.lower(stat.Name):find("энерг")) then
                return stat
            end
        end
    end
    for _, child in ipairs(player:GetChildren()) do
        if child:IsA("NumberValue") and (string.lower(child.Name):find("energy") or string.lower(child.Name):find("энерг")) then
            return child
        end
    end
    return nil
end

local function findUpgradeButton()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (string.lower(obj.Name):find("upgrade") or string.lower(obj.Name):find("апгрейд") or string.lower(obj.Name):find("улучш")) then
            local cd = findClickDetector(obj)
            if cd then return cd end
        end
    end
    for _, gui in ipairs(player.PlayerGui:GetDescendants()) do
        if gui:IsA("TextButton") and (string.lower(gui.Name):find("upgrade") or string.lower(gui.Name):find("апгрейд") or string.lower(gui.Text):find("улучш")) then
            return gui
