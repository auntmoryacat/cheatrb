-- 1. Телепорт к яйцу
local function teleportToEgg()
    local eggs = findAllEggs()
    if #eggs == 0 then
        loginMsg.Text = "❌ Яйца не найдены!"
        loginMsg.TextColor3 = Color3.fromRGB(255, 80, 80)
        task.wait(1)
        loginMsg.Text = ""
        return
    end
    local nearest, dist = nil, math.huge
    for _, egg in ipairs(eggs) do
        if egg:IsA("BasePart") then
            local d = (egg.Position - rootPart.Position).Magnitude
            if d < dist then dist = d; nearest = egg end
        end
    end
    if nearest then
        local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
        local goal = {CFrame = CFrame.new(nearest.Position + Vector3.new(0, 2.5, 0))}
        TweenService:Create(rootPart, tweenInfo, goal):Play()
    end
end

