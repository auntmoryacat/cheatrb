-- ======== ПРОВЕРКА ВХОДА ========
loginBtn.MouseButton1Click:Connect(function()
    local user = userBox.Text:gsub("^%s*(.-)%s*$", "%1")
    local pass = passBox.Text:gsub("^%s*(.-)%s*$", "%1")
    if user == "" or pass == "" then
        showLoginError("Заполните все поля")
        return
    end
    if user == "egor" and pass == "lox" then
        loginMsg.Text = "✅ Доступ разрешён!"
        loginMsg.TextColor3 = Color3.fromRGB(80, 255, 80)
        wait(0.5)
        loginScreen.Enabled = false
        mainScreen.Enabled = true
        blur.Size = 0
    else
        showLoginError("Неверный логин или пароль")
        for i = 1, 4 do
            loginFrame.Position = UDim2.new(0.5, -175 + (i%2==0 and 10 or -10), 0.5, -140)
            wait(0.05)
        end
        loginFrame.Position = UDim2.new(0.5, -175, 0.5, -140)
    end
end)

-- Ввод по Enter
local function onEnter(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
        if loginScreen.Enabled then
            local focused = game:GetService("GuiService"):GetFocusedObject()
            if focused and (focused == userBox or focused == passBox or focused == loginBtn) then
                loginBtn:CaptureFocus()
                loginBtn:Activate()
            end
        end
    end
end
game:GetService("UserInputService").InputBegan:Connect(onEnter)

